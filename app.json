{
  "expo": {
    "name": "login-facial-expo",
    "slug": "login-facial-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La app necesita acceso a la cámara para simular el reconocimiento facial."
      }
    },
    "android": {
      "permissions": ["CAMERA"]
    }
  }
}
